---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string; // Nuevo campo opcional para la imagen
}

const { title, description, href, image } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-slate-100 bg-white p-6 transition-all hover:shadow-lg hover:shadow-primary-100"
>
  {/* Imagen del servicio (si viene definida, la muestra; si no, puedes omitirla o poner un placeholder) */}
  {image && (
    <div class="relative h-40 w-full overflow-hidden rounded-md bg-slate-100 mb-4">
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}

  <h3 class="text-base font-bold text-primary-800 group-hover:text-primary-600 m-0">{title}</h3>
  <p class="mt-2 text-sm text-slate-600 flex-1">{description}</p>
  <span class="mt-4 text-sm font-semibold text-accent-600 group-hover:translate-x-1 transition-transform">Ver más →</span>
</a>