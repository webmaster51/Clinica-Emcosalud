---
import Icon from "@/components/icons/Icon.astro";
import {
  examenesGeneralRecommendations,
  examenesHighlights,
  examenesList,
  examenesNotice,
} from "@/data/examenes-preparacion";
import CitasImagenes from "@/components/react/CitasImagenesForm";

---

<div class="container-page max-w-6xl">
  <div
    class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,26rem)] lg:items-start lg:gap-12"
  >
    <!-- Columna Principal -->
    <div class="space-y-6">
      <!-- Banner Principal -->
      <div
        class="rounded-2xl border border-brand-blue/15 bg-gradient-to-br from-brand-blue/5 to-brand-green/5 p-5 md:p-6"
      >
        <div class="mb-4 flex items-start gap-3">
          <span
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-blue text-white"
          >
            <Icon name="shield-check" size={20} />
          </span>
          <div>
            <h2 class="m-0 text-lg font-bold text-brand-blue md:text-xl">
              {examenesNotice.title}
            </h2>
            <p class="mt-1 text-sm font-semibold text-brand-green-dark">
              {examenesNotice.subtitle}
            </p>
          </div>
        </div>
        <p class="m-0 text-sm leading-relaxed text-slate-700 md:text-base">
          {examenesNotice.intro}
        </p>
      </div>

      <!-- Highlights Grid -->
      <div class="grid gap-3 sm:grid-cols-3">
        {
          examenesHighlights.map((item) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-brand-sm">
              <p class="m-0 flex items-center gap-2 text-sm font-bold text-brand-blue">
                <Icon name="phone" size={18} class="text-brand-green" />
                {item.title}
              </p>
              <p class="mt-2 m-0 text-xs leading-relaxed text-slate-600">
                {item.text}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Cuadro de Advertencia / Importante -->
      <div
        class="flex gap-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-4 shadow-sm"
        role="alert"
      >
        <span
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-200/80 text-amber-900"
        >
          <Icon name="mail" size={18} />
        </span>
        <div>
          <p
            class="m-0 text-xs font-bold uppercase tracking-wide text-amber-900"
          >
            Importante
          </p>
          <p class="mt-1.5 m-0 text-sm leading-relaxed text-amber-950">
            {examenesNotice.warning}
          </p>
        </div>
      </div>

      <!-- Indicaciones Generales -->
      <article class="rounded-2xl border border-slate-200 bg-white p-5 md:p-6">
        <h2 class="m-0 text-lg font-bold text-brand-blue md:text-xl">
          Instrucciones para la toma de exámenes
        </h2>
        <p class="mt-3 mb-4 text-sm font-semibold text-brand-green-dark">
          {examenesNotice.subtitle}
        </p>
        <p class="m-0 text-sm leading-relaxed text-slate-700">
          Estimado usuario, para realizarte cualquier examen en nuestra sede de
          Imagenología, ten en cuenta las siguientes pautas básicas:
        </p>

        <div
          class="mt-5 rounded-xl border border-brand-green/20 bg-brand-green/5 p-4"
        >
          <h3 class="m-0 text-sm font-bold text-brand-blue">
            Recomendaciones importantes
          </h3>
          <ul class="mt-3 m-0 space-y-2 p-0">
            {
              examenesGeneralRecommendations.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-700">
                  <Icon
                    name="shield-check"
                    size={16}
                    class="mt-0.5 shrink-0 text-brand-green-dark"
                  />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="mt-6">
          <a
            href="/servicios/diagnostico-por-imagenes"
            class="btn btn--primary inline-flex items-center gap-2 text-sm font-semibold"
          >
            <Icon name="document" size={18} />
            Ver recomendaciones
          </a>
        </div>
      </article>
    </div>

    <aside class="mx-auto w-full max-w-2xl">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-brand md:p-6">
        <div class="mb-5 border-b border-slate-100 pb-4">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-brand-green-dark">
            Formulario en línea
          </p>

          <h2 class="m-0 text-xl font-bold text-brand-blue">
            Formulario de PQRSF
          </h2>

          <p class="mt-2 m-0 text-sm leading-relaxed text-slate-600">
            Completa tus datos y adjunta los documentos requeridos.
          </p>
        </div>

        <CitasImagenes client:load />
      </div>
    </aside>

    
  </div>
</div>
