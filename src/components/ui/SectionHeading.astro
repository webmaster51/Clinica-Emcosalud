---
interface Props {
  eyebrow?: string;
  title: string;
  center?: boolean;
}
const { eyebrow, title, center = false } = Astro.props;
---

<div class={center ? 'text-center' : ''}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">{eyebrow}</p>}
  <h2 class="mt-1 text-2xl font-bold class="text-brand-green"  sm:text-3xl">{title}</h2>
</div>
