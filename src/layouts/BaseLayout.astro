---
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { site } from "@/data/site";
import "@/styles/global.css";
import CookieBanner from "../components/cookies/CookieBanner.astro";
import Popup from '@/components/react/Popup';


interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;



const consentCookie = Astro.cookies.get('cookies-consent');

// Intentamos parsear la cookie de forma segura utilizando el método .json() de Astro
const permisos = consentCookie ? consentCookie.json() : null;

// Creamos banderas lógicas listas para usar en el HTML
const permitirAnalitica = permisos?.analitica === true;
const permitirPublicidad = permisos?.publicidad === true;
const pseLinks = {
  neiva: "https://merchant.coopcentral.com.co/botonPerzonalidado/79658ebe-ff49-4962-b2eb-251d966bc27a?m_id=36381", // Reemplaza con el link de PSE de Neiva si aplica
  bogota: "https://www.psepagos.co/ZL1/transaccion?link=..." // Reemplaza con el link de PSE de Bogotá si aplica
};

// Slug registrado en el CMS
const PORTAL_SLUG = 'sociedad-clinica-emcosalud';

// 1. OBTENEMOS LA RUTA ACTUAL DINÁMICAMENTE DESDE ASTRO
const currentPath = Astro.url.pathname;

let activePopup = null;

try {
  // 2. ENVIAMOS EL PATH ACTUAL EN LA CONSULTA AL CMS
  const response = await fetch(`http://localhost:4321/api/v1/popups?portal=${PORTAL_SLUG}&path=${currentPath}`, {
    headers: {
      'X-Portal-Slug': PORTAL_SLUG,
    },
  });

  if (response.ok) {
    const result = await response.json();

    if (result.data && result.data.length > 0) {
      activePopup = result.data[0];
    }
  }
} catch (error) {
  console.error('Error al obtener el popup desde la API pública:', error);
}
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/logo-clinica.png" />
    <link rel="apple-touch-icon" href="/images/logo-clinica.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
<!-- Botón Flotante de PSE en la esquina inferior izquierda -->
<div class="fixed bottom-6 left-6 z-50 flex flex-col items-start group">
  
  {/* Menú desplegable que aparece al pasar el cursor (hover) */}
  <div class="mb-3 w-54 translate-y-2 opacity-0 invisible transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-hover:visible">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-xl">
      <div class="border-b border-slate-100 pb-2 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-blue block">Pagos en Línea PSE</span>
        <p class="text-xs text-slate-500">Selecciona tu sede para continuar:</p>
      </div>
      
      <div class="space-y-2">
        <a
          href={pseLinks.neiva}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between rounded-xl bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-brand-green/10 hover:text-brand-blue transition no-underline"
        >
          <span>Sede Neiva</span>
          <span class="text-brand-green font-bold">Pagar aquí →</span>
        </a>

        <a
          href={pseLinks.bogota}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between rounded-xl bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-brand-green/10 hover:text-brand-blue transition no-underline"
        >
          <span>Sede Bogotá</span>
          <span class="text-brand-green font-bold">Pagar aquí →</span>
        </a>
      </div>
    </div>
  </div>

  {/* Contenedor del Botón con la Imagen (Tamaño más grande) */}
  <div class="cursor-pointer transition-transform duration-300 hover:scale-105 focus:outline-none drop-shadow-xl">
    <img
      src="/images/boton-pse.png" 
      alt="Pagos PSE Emcosalud"
      class="h-16 w-auto object-contain rounded-2xl shadow-lg"
    />
  </div>

</div>

    <div class="flex min-h-dvh flex-col">
      <Header />
      <main id="content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <CookieBanner />
    {/* CONSULTA: Si se permitió la analítica, inyectamos el script correspondiente */}
      {permitirAnalitica && (
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-XXXXX-Y"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'UA-XXXXX-Y');
        </script>
      )}

<!--     {/* CONSULTA: Si se permitió la publicidad, inyectamos el píxel */}
      {permitirPublicidad && (
        <script is:inline>
          console.log("Script de marketing/publicidad inicializado");
        </script>
      )}
-->
    <script src="https://cdn.userway.org/widget.js" data-account="jY03tOl3dk"></script>


    {/* 3. RENDERIZAMOS EL POPUP DENTRO DEL BODY (O al final de este) */}
    {activePopup && (
      <Popup 
        client:load 
        id={activePopup.id.toString()}
        title={activePopup.title || activePopup.internal_name} 
        content={activePopup.description || activePopup.content}
        imageUrl={activePopup.imageUrl}
        linkUrl={activePopup.url}
        ctaText={activePopup.buttonText || activePopup.ctaText}
        frequency={activePopup.frequency}
      />
    )}
  </body>
</html>
