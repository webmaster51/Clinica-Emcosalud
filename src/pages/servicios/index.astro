---
import Icon from '@/components/icons/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicioCard from '@/components/sections/ServicioCard.astro';
import { clinicServices } from '@/data/services';

// Mapeamos los datos del archivo central a la estructura que espera tu ServicioCard
const servicios = clinicServices.map((service) => ({
  title: service.title,
  description: service.description,
  href: `/servicios/${service.id}/`, 
  image: service.image
}));
---

<BaseLayout
  title="Nuestros Servicios — Sociedad Clínica Emcosalud"
  description="Conoce nuestra oferta de servicios de salud integrales, especializados y de alta complejidad para ti y tu familia."
>
  {/* Cabecera / Hero principal de la página de servicios */}
  <section class="bg-brand-blue py-12 text-white md:py-16">
    <div class="container-page text-center">
      <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-green-light">
        <Icon name="stethoscope" size={18} />
        Excelencia Médica
      </p>
      <h1 class="m-0 text-3xl font-bold md:text-4xl">
        Nuestros Servicios
      </h1>
      <p class="mt-3 text-base text-slate-200 max-w-2xl mx-auto">
        Atención médica integral, especializada y de alta complejidad con tecnología avanzada y calidad humana.
      </p>
    </div>
  </section>

  {/* Sección principal de cuadrícula de tarjetas */}
  <section class="section-block py-16" id="servicios">
    <div class="container-page">
      
      {/* Cuadrícula de tarjetas */}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {servicios.map((s) => (
          <ServicioCard {...s} />
        ))}
      </div>

    </div>
  </section>
</BaseLayout>