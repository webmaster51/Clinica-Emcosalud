---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AtencionUsuarioHero from '@/components/sections/AtencionUsuarioHero.astro';
---

<BaseLayout
  title="Cuotas Moderadoras y Copagos 2026"
  description="Actualización de los montos a pagar por concepto de copagos y cuotas moderadoras para la vigencia 2026 según la Circular Externa No. 048 de 2025."
>
  <AtencionUsuarioHero
    title="Cuotas Moderadoras y Copagos"
    lead="Consulta la actualización de montos, porcentajes y topes máximos para los regímenes contributivo y subsidiado vigentes para el año 2026."
  />

  <section class="section-block">
    <div class="container-page max-w-5xl space-y-8">

      {/* Información General de la Circular */}
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-4 mb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-green bg-brand-green/10 px-2.5 py-1 rounded-full">Circular Externa No. 048 de 2025</span>
            <h2 class="text-xl font-bold text-brand-blue mt-2">Ministerio de Salud y Protección Social</h2>
          </div>
          <div class="text-right">
            <p class="text-xs text-slate-500">Fecha de emisión: 31 DIC 2025</p>
            <p class="text-sm font-semibold text-slate-700">Valor UVB 2026: <span class="text-brand-blue">$12.110 COP</span></p>
          </div>
        </div>
        <p class="text-slate-700 text-sm leading-relaxed">
          Esta circular establece la actualización de los valores correspondientes a cuotas moderadoras y copagos para el Régimen Contributivo y Régimen Subsidiado, calculados en Unidad de Valor Básico (UVB) para la vigencia 2026, rigiendo a partir del 01 de enero de 2026 de acuerdo con la Ley 2294 de 2023 y la Resolución 3488 de 2025 del Ministerio de Hacienda y Crédito Público.
        </p>
      </div>

      {/* Régimen Contributivo */}
      <div class="space-y-4">
        <div class="border-b-2 border-brand-blue pb-3">
          <h2 class="text-xl font-bold text-brand-blue uppercase tracking-wide">Régimen Contributivo</h2>
        </div>

        {/* Cuotas Moderadoras */}
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
          <h3 class="font-bold text-brand-blue text-base flex items-center gap-2">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-green"></span> Monto y valor de las Cuotas Moderadoras (2026)
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
              <thead class="bg-slate-50 text-xs uppercase text-slate-500 border-b border-slate-200">
                <tr>
                  <th class="p-3">Rango de Ingreso</th>
                  <th class="p-3">UVB</th>
                  <th class="p-3">Valor UVB</th>
                  <th class="p-3">Cuota Moderadora</th>
                  <th class="p-3">Valor Aproximado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr>
                  <td class="p-3 font-medium">Menor a 2 SMLMV</td>
                  <td class="p-3">0.411</td>
                  <td class="p-3">$12.110</td>
                  <td class="p-3">$4.977,21</td>
                  <td class="p-3 font-semibold text-brand-blue">$5.000</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium">Entre 2 y 5 SMLMV</td>
                  <td class="p-3">1.66</td>
                  <td class="p-3">$12.110</td>
                  <td class="p-3">$20.102,60</td>
                  <td class="p-3 font-semibold text-brand-blue">$20.100</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium">Mayor a 5 SMLMV</td>
                  <td class="p-3">4.36</td>
                  <td class="p-3">$12.110</td>
                  <td class="p-3">$52.799,60</td>
                  <td class="p-3 font-semibold text-brand-blue">$52.800</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        {/* Copagos y Topes Contributivo */}
        <div class="grid gap-6 md:grid-cols-2">
          
          {/* Porcentaje de Copago */}
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm space-y-3">
            <h3 class="font-bold text-brand-blue text-base border-b border-slate-100 pb-2">Porcentaje de Copago por Servicio</h3>
            <ul class="space-y-2 text-sm text-slate-700">
              <li class="flex justify-between border-b border-slate-50 pb-1"><span>Menor a 2 SMLMV:</span> <strong class="text-brand-blue">11.50%</strong></li>
              <li class="flex justify-between border-b border-slate-50 pb-1"><span>Entre 2 y 5 SMLMV:</span> <strong class="text-brand-blue">17.30%</strong></li>
              <li class="flex justify-between"><span>Mayor a 5 SMLMV:</span> <strong class="text-brand-blue">23.00%</strong></li>
            </ul>
          </div>

          {/* Tope Máximo por Evento */}
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm space-y-3">
            <h3 class="font-bold text-brand-blue text-base border-b border-slate-100 pb-2">Tope Máximo de Copago por Evento</h3>
            <ul class="space-y-2 text-sm text-slate-700">
              <li class="flex justify-between border-b border-slate-50 pb-1"><span>Menor a 2 SMLMV (30,86 UVB):</span> <strong class="text-brand-blue">$373.715</strong></li>
              <li class="flex justify-between border-b border-slate-50 pb-1"><span>Entre 2 y 5 SMLMV (123,67 UVB):</span> <strong class="text-brand-blue">$1.497.644</strong></li>
              <li class="flex justify-between"><span>Mayor a 5 SMLMV (247,35 UVB):</span> <strong class="text-brand-blue">$2.995.409</strong></li>
            </ul>
          </div>

        </div>

        {/* Tope Máximo Anual Contributivo */}
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-3">
          <h3 class="font-bold text-brand-blue text-base border-b border-slate-100 pb-2">Tope Máximo de Copago por Año (Afiliado Beneficiario)</h3>
          <div class="grid gap-4 sm:grid-cols-3 text-sm text-slate-700">
            <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
              <p class="text-xs text-slate-500 font-medium">Menor a 2 SMLMV (57.5% / 61.84 UVB)</p>
              <p class="text-lg font-bold text-brand-blue mt-1">$748.882</p>
            </div>
            <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
              <p class="text-xs text-slate-500 font-medium">Entre 2 y 5 SMLMV (230% / 247.35 UVB)</p>
              <p class="text-lg font-bold text-brand-blue mt-1">$2.995.409</p>
            </div>
            <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
              <p class="text-xs text-slate-500 font-medium">Mayor a 5 SMLMV (460% / 494.69 UVB)</p>
              <p class="text-lg font-bold text-brand-blue mt-1">$5.990.696</p>
            </div>
          </div>
        </div>

      </div>

      {/* Régimen Subsidiado */}
      <div class="space-y-4 pt-4">
        <div class="border-b-2 border-brand-blue pb-3">
          <h2 class="text-xl font-bold text-brand-blue uppercase tracking-wide">Régimen Subsidiado</h2>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
          <div class="flex items-center gap-3 bg-brand-green/10 p-4 rounded-xl border border-brand-green/20">
            <span class="inline-block h-3 w-3 rounded-full bg-brand-green"></span>
            <p class="text-sm font-semibold text-brand-blue">En el Régimen Subsidiado <span class="underline">no se cobran cuotas moderadoras</span>.</p>
          </div>

          <div class="grid gap-6 md:grid-cols-2 pt-2">
            <div>
              <h4 class="font-bold text-sm text-slate-700 mb-2">Copago Máximo</h4>
              <p class="text-sm text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-100">
                Corresponde al <strong class="text-brand-blue">10% del valor del servicio</strong>.
              </p>
            </div>
            <div>
              <h4 class="font-bold text-sm text-slate-700 mb-2">Topes Máximos por Evento y Año</h4>
              <ul class="space-y-1.5 text-sm text-slate-700 bg-slate-50 p-3 rounded-lg border border-slate-100">
                <li class="flex justify-between"><span>Tope por Evento (50% / 53,77 UVB):</span> <strong class="text-brand-blue">$651.155</strong></li>
                <li class="flex justify-between"><span>Tope Anual (100% / 107,54 UVB):</span> <strong class="text-brand-blue">$1.302.309</strong></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>