---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AtencionUsuarioHero from '@/components/sections/AtencionUsuarioHero.astro';
---

<BaseLayout
  title="Horarios de Atención y Visitas"
  description="Conoce los horarios de visita, líneas de contacto y normativa institucional de la Sociedad Clínica Emcosalud."
>
  <AtencionUsuarioHero
    title="Horarios de Atención y Visitas"
    lead="Consulte la información de contacto, los horarios establecidos para cada área de hospitalización y las pautas institucionales de ingreso."
  />

  <section class="section-block">
    <div class="container-page max-w-5xl">

      {/* Bloque de Contacto General y Aviso Importante */}
      <div class="mb-10 grid gap-6 md:grid-cols-2">
        {/* Canales de Contacto */}
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <h2 class="text-xl font-bold text-brand-blue mb-3">Líneas de Atención</h2>
          <p class="text-slate-700 text-sm mb-4">
            Para mayor información o dudas acerca del estado de los pacientes, comunícate con nosotros a través de nuestros canales oficiales:
          </p>
          <ul class="space-y-2 text-sm text-slate-700">
            <li class="flex items-center gap-2">
              <strong class="text-brand-blue">Línea gratuita:</strong> 018000182041
            </li>
            <li class="flex items-center gap-2">
              <strong class="text-brand-blue">Teléfono fijo:</strong> 8630566
            </li>
          </ul>
        </div>

        {/* ¡Importante! Restricciones */}
        <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-6 sm:p-8">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block h-3 w-3 rounded-full bg-amber-500"></span>
            <h2 class="text-xl font-bold text-amber-900 uppercase tracking-wide">¡Importante!</h2>
          </div>
          <ul class="space-y-3 text-sm text-slate-700 list-disc pl-5">
            <li><strong>No se permiten visitas con menores de 10 años.</strong></li>
            <li>Los acompañantes permanentes deben estar autorizados a través de una orden médica.</li>
          </ul>
        </div>
      </div>

      {/* Tabla / Tarjetas de Horarios por Servicio */}
      <div class="space-y-4">
        <div class="border-b-2 border-brand-blue pb-3 mb-6">
          <h2 class="text-xl font-bold text-brand-blue uppercase tracking-wide">Horarios de Visitas por Servicio</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          
          {/* UCI Adultos */}
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-brand-blue text-base mb-2 flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-green"></span> UCI Adultos
            </h3>
            <p class="text-sm text-slate-700 mb-2"><strong>Horario:</strong> 9:00 AM a 1:00 PM y 3:00 PM a 7:00 PM</p>
            <p class="text-xs text-slate-500"><strong>Contacto:</strong> uciadultos.emcosalud@gmail.com</p>
          </div>

          {/* UCI Neonatal */}
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-brand-blue text-base mb-2 flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-green"></span> UCI Neonatal
            </h3>
            <p class="text-sm text-slate-700 mb-2"><strong>Horario:</strong> 24 horas para los padres, siguiendo protocolos de bioseguridad.</p>
            <p class="text-xs text-slate-500"><strong>Contacto:</strong> ucineonatal.emcosalud@gmail.com</p>
          </div>

          {/* Hospitalización 3° y 4° Piso */}
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-brand-blue text-base mb-2 flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-green"></span> Hospitalización (Tercero y Cuarto Piso)
            </h3>
            <p class="text-sm text-slate-700 mb-2"><strong>Horario:</strong> 9:00 AM a 1:00 PM y 3:00 PM a 7:00 PM</p>
            <p class="text-xs text-slate-500"><strong>Contacto:</strong> hospitalizacion.emcosalud@gmail.com</p>
          </div>

          {/* Observación Urgencias */}
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-brand-blue text-base mb-2 flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-green"></span> Observación Urgencias
            </h3>
            <p class="text-sm text-slate-700 mb-2"><strong>Horario:</strong> 9:00 AM a 1:00 PM y 3:00 PM a 7:00 PM</p>
            <p class="text-xs text-slate-500"><strong>Contacto:</strong> urgencias.emcosalud@gmail.com</p>
          </div>

        </div>
      </div>

    </div>
  </section>
</BaseLayout>