---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AtencionUsuarioHero from '@/components/sections/AtencionUsuarioHero.astro';
import Icon from '@/components/icons/Icon.astro';

const pdfUrl = '/documents/RUTA-DE-ATENCION-EVENTOS-DE-SALUD-MENTAL.pdf';
const title = 'Ruta de Atención Evento Salud Mental';
---

<BaseLayout
  title="Ruta de Atención en Salud Mental"
  description="Documento oficial de la ruta de atención para eventos de salud mental — EMCOSALUD."
>
  <AtencionUsuarioHero
    title="Ruta de Atención en Salud Mental"
    lead="Conoce los protocolos, flujos y pautas institucionales para la atención integral y oportuna en salud mental."
  />

  <section class="section-block">
    <div class="container-page max-w-5xl">

      {/* Introducción / Compromiso */}
      <div class="mb-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-brand-blue mb-4">Atención Integral y Oportuna</h2>
        <p class="text-slate-700 mb-4 text-base">
          En Sociedad Clínica Emcosalud priorizamos el bienestar emocional y psicológico de nuestros usuarios. Esta ruta establece las directrices claras para la detección temprana, remisión y manejo especializado de los eventos de salud mental.
        </p>
        <p class="text-slate-700 text-sm leading-relaxed">
          Diseñada bajo los lineamientos del Ministerio de Salud y Protección Social, garantizamos una atención con enfoque diferencial, respeto por la dignidad humana y un acompañamiento profesional continuo para el paciente y su red de apoyo.
        </p>
      </div>

      {/* Acciones Rápidas (Abrir / Descargar) */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-3 w-3 rounded-full bg-brand-green"></span>
          <span class="text-sm font-bold text-brand-blue uppercase tracking-wide">Documento Oficial PDF</span>
        </div>
        
        <div class="flex items-center gap-3">
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-brand-blue px-4 py-2 text-sm font-semibold text-white no-underline shadow-sm transition hover:bg-brand-blue/90"
          >
            <span>Abrir en ventana nueva</span>
            <Icon name="external" size={16} class="shrink-0 opacity-80" />
          </a>
          <a
            href='{pdfUrl}'
            download
            class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 no-underline shadow-sm transition hover:border-brand-green/40 hover:bg-brand-green/5"
          >
            <span>Descargar PDF</span>
          </a>
        </div>
      </div>

      {/* Visor Integrado del PDF */}
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        {/* Barra superior del visor */}
        <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-5 py-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            Vista Previa del Documento
          </span>
          <span class="text-xs font-medium text-slate-400">PDF Institucional</span>
        </div>

        {/* Visor iframe limpio sin nodos hijos conflictivos */}
        <div class="relative w-full bg-slate-100" style="height: 750px;">
          <iframe
            src={`${pdfUrl}#view=FitH`}
            class="h-full w-full border-0"
            title={title}
          />
        </div>
      </div>

    </div>
  </section>
</BaseLayout>