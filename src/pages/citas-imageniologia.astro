---
import Icon from '@/components/icons/Icon.astro';
import PreparacionExamenesContent from '@/components/sections/PreparacionExamenesContent.astro';
import { preparacionExamenesMeta } from '@/data/examenes-preparacion';
import BaseLayout from '@/layouts/BaseLayout.astro';


---

<BaseLayout title={preparacionExamenesMeta.title} description={preparacionExamenesMeta.description}>
  <section class="bg-brand-blue py-12 text-white md:py-14">
    <div class="container-page">
      <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-green-light">
        <Icon name="calendar" size={18} />
        Servicios
      </p>
      <h1 class="m-0 text-3xl font-bold md:text-4xl">{preparacionExamenesMeta.pageTitle}</h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/90 md:text-lg">
        {preparacionExamenesMeta.description}
      </p>
    </div>
  </section>

  <section class="section-block">
    <PreparacionExamenesContent />
  </section>

</BaseLayout>